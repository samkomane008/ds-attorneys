// Cloudflare Workers static site. GitHub Actions builds Jekyll into _site, then deploys it.
{
  "name": "ds-attorneys",
  "compatibility_date": "2026-10-19",
  "routes": [
    { "pattern": "attds.co.za", "custom_domain": true }
  ],
  "assets": {
    "directory": "_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
